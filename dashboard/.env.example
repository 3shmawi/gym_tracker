# Copy to .env.local for `npm run dev`. Publishable values only: they end
# up in the public bundle. Supabase → Project settings → API Keys.
VITE_SUPABASE_URL=https://abcdefghijklmnopqrst.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_example_not_a_real_key
# Optional: Cloudflare Turnstile site key (publishable). Set it once CAPTCHA
# protection is on in Supabase (it covers sign-in too). Empty = no captcha.
VITE_TURNSTILE_SITE_KEY=
