# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# --- flutter-project-kit ---
# Environment values (only env/example.json is committed)
env/*.json
!env/example.json
# Signing material — never commit
android/key.properties
*.jks
*.keystore
*.p8
*.p12
*.mobileprovision
# Generated
lib/l10n/gen/
coverage/
flavorizr.log
analyze.log
test.log
supabase_init.log
branding.log
fonts.log
supabase/.temp/
supabase/.branches/
# FVM (the pinned version lives in .fvmrc, which is committed)
.fvm/
test/**/failures/

# Invite cards hold live codes: never commit them (scripts/make_invites)
azm-invites/
invites-*.pdf
supabase/functions/.env
supabase/functions/**/.env

# Move games: videos are turned into pose recordings on the owner's computer
# (tool/pose_record/); the videos themselves never go in the repo.
*.mp4
*.mov
*.m4v
*.avi
*.webm
*.mkv
tool/pose_record/.venv/
