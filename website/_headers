# Cloudflare Pages custom headers. Apple and Google fetch these two files
# and want JSON; the AASA file has no extension, so Pages would serve it as
# application/octet-stream. Keep both free of redirects (see docs/deep_links.md).
/.well-known/apple-app-site-association
  Content-Type: application/json
  Cache-Control: public, max-age=3600
/.well-known/assetlinks.json
  Content-Type: application/json
  Cache-Control: public, max-age=3600
